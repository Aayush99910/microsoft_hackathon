# Copy to .env and fill in. Never commit .env.
FOUNDRY_PROJECT_ENDPOINT=https://matchbrain-foundry.services.ai.azure.com/api/projects/matchbrain
FOUNDRY_MODEL_DEPLOYMENT=gpt-5-mini

# Local development: key auth (Foundry portal home page -> API key). Leave empty on Azure.
FOUNDRY_OPENAI_ENDPOINT=https://matchbrain-foundry.openai.azure.com/openai/v1
FOUNDRY_API_KEY=
# On Azure: set FOUNDRY_AUTH=identity instead of a key (managed identity)
FOUNDRY_AUTH=

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
